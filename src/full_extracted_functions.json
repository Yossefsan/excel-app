  "MATCH": [
    {
      "component": "Title",
      "property": "Text",
      "value": "دالة تحديد الموقع (MATCH)"
    },
    {
      "component": "Lbl_Description",
      "property": "Text",
      "value": "تبحث هذه الدالة عن قيمة معينة داخل نطاق من الخلايا، وتعطيك رقم ترتيبها (مكانها) في هذا النطاق. (مثال: إذا بحثت عن 'أحمد' في قائمة أسماء، وكان هو الاسم الثالث، ستعطيك الدالة الرقم 3)."
    },
    {
      "component": "Start_Image",
      "property": "Picture",
      "value": "https://softwareaccountant.com/wp-content/uploads/2019/04/Match-function-Excel-image-2.png.webp"
    },
    {
      "component": "Lbl_Description2",
      "property": "Text",
      "value": "اكتب =MATCH( ثم حدد القيمة التي تبحث عنها (أو الخلية التي تحتوي عليها) متبوعة بفاصلة."
    },
    {
      "component": "Lbl_Description3",
      "property": "Text",
      "value": "حدد العمود أو الصف الذي يحتوي على البيانات، ثم اكتب الرقم 0 لضمان الحصول على تطابق تام (Exact Match)."
    },
    {
      "component": "Lbl_Syntax",
      "property": "Text",
      "value": "=MATCH(lookup_value, lookup_array, [match_type])"
    },
    {
      "component": "Start_Image2",
      "property": "Picture",
      "value": "https://softwareaccountant.com/wp-content/uploads/2019/04/Match-function-Excel-image-3.jpg.webp"
    },
    {
      "component": "Lbl_Description4",
      "property": "Text",
      "value": "اضغط Enter. سيظهر لك رقم يمثل ترتيب القيمة داخل القائمة التي حددتها."
    },
    {
      "component": "Start_Image3",
