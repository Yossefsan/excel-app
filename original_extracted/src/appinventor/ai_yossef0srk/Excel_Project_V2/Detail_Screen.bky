stance_name="WebViewer1"></mutation><field name="COMPONENT_SELECTOR">WebViewer1</field><field name="PROP">HomeUrl</field><value name="VALUE"><block type="text" id="MG#wtJ6P:;Yb~_:-Oh8p"><field name="TEXT">https://excel-practice-online.com/wp-content/uploads/2019/11/COUNT.gif</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><value name="IF2"><block type="logic_compare" id="^Q)MIqddpMh}-0{IL}5U"><field name="OP">EQ</field><value name="A"><block type="controls_getStartValue" id="7yYj7bRy^oHO={iSw(*="></block></value><value name="B"><block type="text" id="g!.BY[ITbtz6D]uTJFYy"><field name="TEXT">AVERAGE</field></block></value></block></value><statement name="DO2"><block type="component_set_get" id="zucN7o?u[;IQejnP?3{R"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Title"></mutation><field name="COMPONENT_SELECTOR">Title</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="8ny@jz}[1VeAd70}=i8b"><field name="TEXT">دالة المتوسط الحسابي (AVERAGE)</field></block></value><next><block type="component_set_get" id="kM|f.c|0yd-bk@vp_}7M"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="Mb~@WDe?6mzw+@?jTA4L"><field name="TEXT">تستخدم هذه الدالة لحساب متوسط مجموعة من الأرقام (أي مجموعهم مقسوماً على عددهم). وهي مفيدة جداً لحساب معدلات درجات الطلاب أو متوسط المبيعات.</field></block></value><next><block type="component_set_get" id="`.b8QXE2Vbc|L3nPPMeN"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image"></mutation><field name="COMPONENT_SELECTOR">Start_Image</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="O+FS3T_7Y4op%43fP9Gd"><field name="TEXT">https://www.w3schools.com/excel/average3.png</field></block></value><next><block type="component_set_get" id="g2]9cA4An-}Er|fn1{{*"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description2"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description2</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="XZ^d{{Fip|};19p!vt1a"><field name="TEXT">حدد الخلية التي تود ظهور المعدل بها، ثم اكتب علامة التساوي متبوعة باسم الدالة وافتح قوساً:</field></block></value><next><block type="component_set_get" id="72vUlBx]#+(ih4163xcb"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description3"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description3</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="hvIjObPJGQP3u04LH9RC"><field name="TEXT">قم بسحب الماوس لتحديد مجموعة الخلايا التي تريد عدّ الأرقام بداخلها. ستلاحظ أن الإكسيل كتب نطاق الخلايا تلقائياً داخل القوس.</field></block></value><next><block type="component_set_get" id="|!dg9#gpS^G+?2mh@Ip0"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Syntax"></mutation><field name="COMPONENT_SELECTOR">Lbl_Syntax</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="35.k*0*gL5v(cFsP,~zO"><field name="TEXT">طريقة كتابتها تكون (AVERAGE="نطاق الخلية")</field></block></value><next><block type="component_set_get" id="BAKu:RY*zu`O:GbLnl(+"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image2"></mutation><field name="COMPONENT_SELECTOR">Start_Image2</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="#xGGk[gV?nn-y5d2NU$V"><field name="TEXT">https://www.w3schools.com/excel/average4.png</field></block></value><next><block type="component_set_get" id="?=7//[|0I?30j)1i#0z-"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description4"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description4</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="Z`lYMs~p3CxdlS_Ueu#("><field name="TEXT">اضغط Enter لحفظ الدالة وتطبيقها</field></block></value><next><block type="component_set_get" id="GlArOGsDol10uteeW{U("><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image3"></mutation><field name="COMPONENT_SELECTOR">Start_Image3</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="$3eb^iX#HJL_;j/u~p/8"><field name="TEXT">https://www.w3schools.com/excel/average5.png</field></block></value><next><block type="component_set_get" id="xA#|@9k)+i7q_agC7PQB"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description6"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description6</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="r27ZQJ_Kjg7p+3b(*qh="><field name="TEXT">جرب الدلة مثل ما ظاهر امامك</field></block></value><next><block type="component_set_get" id=":cNeN6ifEFoH8ezn=b?l"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="WebViewer" set_or_get="set" property_name="HomeUrl" is_generic="false" instance_name="WebViewer1"></mutation><field name="COMPONENT_SELECTOR">WebViewer1</field><field name="PROP">HomeUrl</field><value name="VALUE"><block type="text" id="#C+B(uV!:t`BFchbwp)}"><field name="TEXT">https://excel-practice-online.com/wp-content/uploads/2019/11/lP1raiz3R3.gif</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><value name="IF3"><block type="logic_compare" id="b~tNrgl#Yaok|eio(Bvp"><field name="OP">EQ</field><value name="A"><block type="controls_getStartValue" id="gSF*KB[SVqr$fxj+#)sF"></block></value><value name="B"><block type="text" id="inZ!,;B8Z2n2lMXI[6ww"><field name="TEXT">IF</field></block></value></block></value><statement name="DO3"><block type="component_set_get" id="4E7ug=WT7FF_+@@~Gqou"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Title"></mutation><field name="COMPONENT_SELECTOR">Title</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="aOPQcD*_,EC[!-~lS@Zb"><field name="TEXT">دالة الشرط (IF)</field></block></value><next><block type="component_set_get" id="jJ}h5.Ab)Aw!l@f/K%~z"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="wa/xfI.5@;.Mk|RIWXn{"><field name="TEXT">تستخدم دالة IF للتحقق من شرط معين؛ فإذا تحقق الشرط (True) تعطي نتيجة محددة، وإذا لم يتحقق (False) تعطي نتيجة أخرى. (مثال: إذا كانت الدرجة أكبر من 50 اكتب 'ناجح'، وإلا اكتب 'راسب').</field></block></value><next><block type="component_set_get" id="wtPBlTXF|?zCz/Wn}vyw"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image"></mutation><field name="COMPONENT_SELECTOR">Start_Image</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="({+=Q*iK}fUU{!p]Ie60"><field name="TEXT">https://www.w3schools.com/excel/img_excel_if_grass2.png</field></block></value><next><block type="component_set_get" id="d5I-QH[UnEPS-tcbfdKM"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description2"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description2</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="!k:V_52Y!HJ+L#Bg1iW{"><field name="TEXT">اضغط على الخلية المطلوبة واكتب =IF( ثم حدد الخلية التي بها الدرجة واكتب علامة الأكبر من أو يساوي والدرجة،</field></block></value><next><block type="component_set_get" id="Fb)UAP*t2W][GZu(g6v:"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description3"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description3</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="k^tW$[](J2|J;wtg0J*."><field name="TEXT">بعد الفاصلة، اكتب النتيجة التي تريدها إذا تحقق الشرط بين علامتي تنصيص "ناجح"، ثم فاصلة أخرى، واكتب النتيجة إذا لم يتحقق "راسب"، ثم أغلق القوس.</field></block></value><next><block type="component_set_get" id="i^[D*Od;aM6n9?/l3}$Y"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Syntax"></mutation><field name="COMPONENT_SELECTOR">Lbl_Syntax</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="[)zCFgu`TvdL`L/BGl.m"><field name="TEXT">=IF(logical test,[value if true],[value if false])</field></block></value><next><block type="component_set_get" id="p(TYG8XL1yj6|N`AAZS{"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image2"></mutation><field name="COMPONENT_SELECTOR">Start_Image2</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="{Jm1]x|VDbtG=|*!7OI%"><field name="TEXT">https://www.w3schools.com/excel/img_excel_if_grass4.png</field></block></value><next><block type="component_set_get" id="L{_a:(mQKEMMM[{{u]Yl"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description4"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description4</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="|$97HzxJeBG00t@|J!L]"><field name="TEXT">اضغط Enter لحفظ الدالة وتطبيقها</field></block></value><next><block type="component_set_get" id="6skjNS{*,t77I33H]oA%"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image3"></mutation><field name="COMPONENT_SELECTOR">Start_Image3</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="Ls1H3h.sLQ)B[]$P+li,"><field name="TEXT">https://www.w3schools.com/excel/img_excel_if_grass5.png</field></block></value><next><block type="component_set_get" id="M#Ytk2e@?Z.dp?yI:X1j"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description6"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description6</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="u8)wN%VQQ^pz3B|Qg_eY"><field name="TEXT">جرب الدلة مثل ما ظاهر امامك</field></block></value><next><block type="component_set_get" id="koB9-%3?G=qT`=G7P!0["><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="WebViewer" set_or_get="set" property_name="HomeUrl" is_generic="false" instance_name="WebViewer1"></mutation><field name="COMPONENT_SELECTOR">WebViewer1</field><field name="PROP">HomeUrl</field><value name="VALUE"><block type="text" id=";B^r)Z{cW2o*sX/2m$l."><field name="TEXT">https://excel-practice-online.com/wp-content/uploads/2019/11/IF.gif</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><value name="IF4"><block type="logic_compare" id="^jC[Aii+M6w1RW{5?0`v"><field name="OP">EQ</field><value name="A"><block type="controls_getStartValue" id="~v[wSWev=#gK@xAR@J6k"></block></value><value name="B"><block type="text" id="v++%^2G(Tp,Qo4pxZDcu"><field name="TEXT">IFS</field></block></value></block></value><statement name="DO4"><block type="component_set_get" id="cE!+2YD88Oz+nlR@+8zo"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Title"></mutation><field name="COMPONENT_SELECTOR">Title</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="KX7q?2L7C]5DjpR?{S;p"><field name="TEXT">دالة الشروط المتعددة (IFS)</field></block></value><next><block type="component_set_get" id="!uwVav=?7dY9m-9-8q3@"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="o-qanG~,ikr%)7X=xImf"><field name="TEXT">تستخدم هذه الدالة للتحقق من عدة شروط في وقت واحد وإعطاء نتيجة لكل شرط. هي البديل الأسهل لدالة IF عندما يكون لديك أكثر من احتمالين (مثل تقديرات الطلاب: ممتاز، جيد جداً، جيد...).</field></block></value><next><block type="component_set_get" id="8Bmqc{3Ooo0X5iJ-TO.d"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image"></mutation><field name="COMPONENT_SELECTOR">Start_Image</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="evK,0[|5_+~gzJzN/jBR"><field name="TEXT">https://www.w3schools.com/excel/img_excel_ifs.png</field></block></value><next><block type="component_set_get" id="$W.Rpd~t^l.qw*JbbC-v"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description2"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description2</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="/{MDL391M{nBca+hQx[S"><field name="TEXT">اكتب =IFS( ثم ابدأ بالشرط الأول ونتيجته، ثم الشرط الثاني ونتيجته. مثال: IFS(A1&gt;=90, "ممتاز", A1&gt;=80, "جيد جداً").</field></block></value><next><block type="component_set_get" id="9l.=A0.RfMK:%p}ibm%8"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description3"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description3</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id=";aD4LD6t=K6`N4U_=qBN"><field name="TEXT">استمر في إضافة الشروط والنتائج بنفس الترتيب. تأكد من وضع النتيجة بين علامتي تنصيص " ".</field></block></value><next><block type="component_set_get" id="n]:pUP$4@KE`U*[Sn*mu"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Syntax"></mutation><field name="COMPONENT_SELECTOR">Lbl_Syntax</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="{UMgE^aCRNmO(}3;#6@`"><field name="TEXT">=IFS(logical_test1, value_if_true1, [logical_test2, value_if_true2], [logical_test3; ...)</field></block></value><next><block type="component_set_get" id="t]/!j{!5a=:3DWpqQ+G6"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image2"></mutation><field name="COMPONENT_SELECTOR">Start_Image2</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="fINvt?r:?IH9Yw;8K;Kh"><field name="TEXT">https://www.w3schools.com/excel/img_excel_ifs3.png</field></block></value><next><block type="component_set_get" id="TsQQs]PeI(_#N;tSfOLU"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description4"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description4</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="|Jm(~B3_v/(;@4Z|r!q@"><field name="TEXT">اضغط Enter. سيفحص الإكسيل الخلية ويعطيك التقدير المناسب للشرط الذي تحقق أولاً.</field></block></value><next><block type="component_set_get" id="a62v|71oLb0lZ|rbV[B8"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image3"></mutation><field name="COMPONENT_SELECTOR">Start_Image3</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="S,Gf?07Vt-L(dxS#{MB}"><field name="TEXT">https://www.w3schools.com/excel/img_excel_ifs5.png</field></block></value><next><block type="component_set_get" id=":h3!~THN+~vwTZn9w?sm"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description6"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description6</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="Xgv)+sjM{v`b@Joaz,9!"><field name="TEXT">جرب الدلة مثل ما ظاهر امامك</field></block></value><next><block type="component_set_get" id="TGql]JnRMPP?xJ)-:MC~"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="WebViewer" set_or_get="set" property_name="HomeUrl" is_generic="false" instance_name="WebViewer1"></mutation><field name="COMPONENT_SELECTOR">WebViewer1</field><field name="PROP">HomeUrl</field><value name="VALUE"><block type="text" id="3g9}I2JmrL.A2~N5M$ga"><field name="TEXT">https://cdn.educba.com/academy/wp-content/uploads/2019/01/Multiple-IFS-Example-2-5.gif</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><value name="IF5"><block type="logic_compare" id="^UWhev.e((8ICMbl?!{6"><field name="OP">EQ</field><value name="A"><block type="controls_getStartValue" id="vP)GNt;?pEU+]SDn){FF"></block></value><value name="B"><block type="text" id="Wb.=x4WHQmvhN$l}6o+-"><field name="TEXT">AND</field></block></value></block></value><statement name="DO5"><block type="component_set_get" id="cseFdXK9j~w;(v92~0Xy"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Title"></mutation><field name="COMPONENT_SELECTOR">Title</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="41H.q=nt[KAe;/Jijw};"><field name="TEXT">دالة التحقق المشترك (AND)</field></block></value><next><block type="component_set_get" id="vi^*xqPWge{Va#T.1Jz8"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="?Ut!Q_6Lh1$h;@b2)AR:"><field name="TEXT">تستخدم هذه الدالة للتحقق من عدة شروط في وقت واحد. النتيجة تكون TRUE (صح) فقط إذا كانت جميع الشروط المذكورة صحيحة، وتكون FALSE (خطأ) إذا فشل شرط واحد على الأقل.</field></block></value><next><block type="component_set_get" id="j]Z3$Z8[#M.#JufH}fp~"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image"></mutation><field name="COMPONENT_SELECTOR">Start_Image</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="[IkOG33lie@)4%RD#.WD"><field name="TEXT">https://www.w3schools.com/excel/img_excel_and2.png</field></block></value><next><block type="component_set_get" id="T~1plNm9zQ^782L$a_4e"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description2"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description2</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="Pnp3$Kcd*:MWX+L4=TRg"><field name="TEXT">اكتب =AND( ثم ابدأ بوضع شروطك يفصل بينها فاصلة. مثال: تريد التأكد أن درجة الطالب أكبر من 50 (A1&gt;50) وأنه لم يتغيب (B1&lt;3)</field></block></value><next><block type="component_set_get" id="@_bdH2oeVEVF{;q44IrB"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description3"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description3</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="CG__z_MWxJ4V)x$A+%j_"><field name="TEXT">أغلق القوس بعد الانتهاء من إضافة كافة الشروط التي تريد اختبارها.</field></block></value><next><block type="component_set_get" id="6yfAuwnF#PVwjiUuRVU["><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Syntax"></mutation><field name="COMPONENT_SELECTOR">Lbl_Syntax</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="Vx?9$CIG1@)Gj!lgy*KC"><field name="TEXT">=AND(logical1, [logical2], …)</field></block></value><next><block type="component_set_get" id="[*T9^MrrB|l@:U[,0a*:"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image2"></mutation><field name="COMPONENT_SELECTOR">Start_Image2</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="UrlWruCz1W**t:/HDK47"><field name="TEXT">https://www.w3schools.com/excel/img_excel_and3.png</field></block></value><next><block type="component_set_get" id="!0!aVaQyfyXcKn)@*];Z"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description4"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description4</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id=".h[E2|ri9:unq+jFXMmc"><field name="TEXT">اضغط Enter. إذا ظهر لك TRUE فهذا يعني أن كل الشروط انطبقت، وإذا ظهر FALSE فهناك شرط واحد على الأقل لم يتحقق.</field></block></value><next><block type="component_set_get" id="[nHiiq.=HAPut%lt`iaF"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image3"></mutation><field name="COMPONENT_SELECTOR">Start_Image3</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="30hYzjo1{9P.py!e/VyJ"><field name="TEXT">https://www.w3schools.com/excel/img_excel_and5.png</field></block></value><next><block type="component_set_get" id="KWaRFujxJ?l]4YOxLSfM"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description6"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description6</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="HcZfMC9j0XF%`5|7{Rn|"><field name="TEXT">جرب الدلة مثل ما ظاهر امامك</field></block></value><next><block type="component_set_get" id="k)_@EZ+tD,q~}/.0+(=~"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="WebViewer" set_or_get="set" property_name="HomeUrl" is_generic="false" instance_name="WebViewer1"></mutation><field name="COMPONENT_SELECTOR">WebViewer1</field><field name="PROP">HomeUrl</field><value name="VALUE"><block type="text" id="hQ_.dN$?BysDtl~Oi)dQ"><field name="TEXT">https://excel-practice-online.com/wp-content/uploads/2020/10/and_or_if.gif</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><value name="IF6"><block type="logic_compare" id="w_M_Q5bQT#/YK[r5Ks~D"><field name="OP">EQ</field><value name="A"><block type="controls_getStartValue" id=".Q8_8k6#^@DS|K7jN7Cj"></block></value><value name="B"><block type="text" id="v,2f60z[9$lBnq]*=K^f"><field name="TEXT">MATCH</field></block></value></block></value><statement name="DO6"><block type="component_set_get" id="VT,tmd-V$%fDRdXtyf?p"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Title"></mutation><field name="COMPONENT_SELECTOR">Title</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="V=:7AWG?9+2E0e?}B~+%"><field name="TEXT">دالة تحديد الموقع (MATCH)</field></block></value><next><block type="component_set_get" id="VsRdf(t%F|t:W`_2E_Ma"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="U*9jB`]Tj:M-Xt]3JSG!"><field name="TEXT">تبحث هذه الدالة عن قيمة معينة داخل نطاق من الخلايا، وتعطيك رقم ترتيبها (مكانها) في هذا النطاق. (مثال: إذا بحثت عن 'أحمد' في قائمة أسماء، وكان هو الاسم الثالث، ستعطيك الدالة الرقم 3).</field></block></value><next><block type="component_set_get" id="@P,E9rk(!`tg!D+Y2FU4"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image"></mutation><field name="COMPONENT_SELECTOR">Start_Image</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="VgT1qwKt;0nluGBgHe9A"><field name="TEXT">https://softwareaccountant.com/wp-content/uploads/2019/04/Match-function-Excel-image-2.png.webp</field></block></value><next><block type="component_set_get" id="8;ga+|O2DvPObMl!`)nz"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description2"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description2</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="Deyfy*[Ox1tZicLr9Rm$"><field name="TEXT">اكتب =MATCH( ثم حدد القيمة التي تبحث عنها (أو الخلية التي تحتوي عليها) متبوعة بفاصلة.</field></block></value><next><block type="component_set_get" id="i]qzP@h6KW]64pF$Q_AI"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description3"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description3</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="*+Nos/05D|/Lk7u]~*g-"><field name="TEXT">حدد العمود أو الصف الذي يحتوي على البيانات، ثم اكتب الرقم 0 لضمان الحصول على تطابق تام (Exact Match).</field></block></value><next><block type="component_set_get" id="!`{bfYeh8@]4#RB5`yks"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Syntax"></mutation><field name="COMPONENT_SELECTOR">Lbl_Syntax</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="SHCR|YjR_PB;63JLWBCp"><field name="TEXT">=MATCH(lookup_value, lookup_array, [match_type])</field></block></value><next><block type="component_set_get" id="[%x66Z2/P,:)MxM)$cK^"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image2"></mutation><field name="COMPONENT_SELECTOR">Start_Image2</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="/s-]v*14Jc@9rD|8nt40"><field name="TEXT">https://softwareaccountant.com/wp-content/uploads/2019/04/Match-function-Excel-image-3.jpg.webp</field></block></value><next><block type="component_set_get" id="wYGu0etHko#iA~*K_})+"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description4"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description4</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id=":v_5AC+soE}V4uMhh[%a"><field name="TEXT">اضغط Enter. سيظهر لك رقم يمثل ترتيب القيمة داخل القائمة التي حددتها.</field></block></value><next><block type="component_set_get" id="k$_=!L-s[sq:#$*GC$XO"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image3"></mutation><field name="COMPONENT_SELECTOR">Start_Image3</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="l,Wa2CurN`neBARbSqhG"><field name="TEXT">https://softwareaccountant.com/wp-content/uploads/2019/04/Match-function-Excel-image-5.png.webp</field></block></value><next><block type="component_set_get" id="EKmw|[/FB5^r6L1Q:V[h"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description6"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description6</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="i=.iJ0GrJ7%{,%I5nF+u"><field name="TEXT">جرب الدلة مثل ما ظاهر امامك</field></block></value><next><block type="component_set_get" id="r-VT!ct8]0OQ$}kK?RsH"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="WebViewer" set_or_get="set" property_name="HomeUrl" is_generic="false" instance_name="WebViewer1"></mutation><field name="COMPONENT_SELECTOR">WebViewer1</field><field name="PROP">HomeUrl</field><value name="VALUE"><block type="text" id="9m2{`i:r(3W$].F+U6O2"><field name="TEXT">https://softwareaccountant.com/wp-content/uploads/2019/04/Match-function-Excel-image-6.gif</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><value name="IF7"><block type="logic_compare" id="eJf~eQb[._YJ14wVI,|M"><field name="OP">EQ</field><value name="A"><block type="controls_getStartValue" id="qTdTx(6|tBP8:$OM6QK4"></block></value><value name="B"><block type="text" id="v!#b%tG?!`!;~;]vWTSj"><field name="TEXT">VLOOKUP</field></block></value></block></value><statement name="DO7"><block type="component_set_get" id="c_!WFt%ajOu*/,[En*G:"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Title"></mutation><field name="COMPONENT_SELECTOR">Title</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="r+^X1weV^XQ%12}ebD2~"><field name="TEXT">دالة البحث الرأسي (VLOOKUP)</field></block></value><next><block type="component_set_get" id=")6*|0%#Dt4gL@Q2iOQt="><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id=")TC,Yt|-bc=t4QM{x5kH"><field name="TEXT">تستخدم هذه الدالة للبحث عن قيمة في العمود الأول من جدول معين، ثم جلب معلومة مقابلة لها من عمود آخر في نفس الصف. (مثال: ابحث عن 'رقم الطالب' في جدول البيانات، وأعطني 'اسمه' أو 'عنوانه').</field></block></value><next><block type="component_set_get" id="|$;_F~h9z];(d_5Aen`o"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image"></mutation><field name="COMPONENT_SELECTOR">Start_Image</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="B#TYoHFdb66/1ty+~S[6"><field name="TEXT">https://www.w3schools.com/excel/vlookup_col.png</field></block></value><next><block type="component_set_get" id="H^ks~|VJ9HFrvb|4ASRL"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description2"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description2</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="@b0DTq[16ic429~6Al$c"><field name="TEXT">اكتب =VLOOKUP( ثم حدد الخلية التي تحتوي على القيمة التي تبحث عنها (مثلاً كود الموظف)، ثم ضع فاصلة.</field></block></value><next><block type="component_set_get" id="|Wd$cxv~D=a)D{D.6P3*"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description3"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description3</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="=6U3*1Fi[qvTZdW|05~`"><field name="TEXT">حدد الجدول كاملاً، ثم اكتب رقم العمود الذي يحتوي على المعلومة التي تريد جلبها (مثلاً العمود رقم 2 للاسم)، ثم ضع فاصلة.</field></block></value><next><block type="component_set_get" id="_zBAagF6Pp=xVkN*IF/H"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Syntax"></mutation><field name="COMPONENT_SELECTOR">Lbl_Syntax</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="{;[--9^$o*p|};qBxOvH"><field name="TEXT">=VLOOKUP(lookup_value, table_array, col_index_num, [range_lookup])</field></block></value><next><block type="component_set_get" id="].Qx(~r}7.HP4X5mIg-+"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image2"></mutation><field name="COMPONENT_SELECTOR">Start_Image2</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="c~!_=2PyMppgUd+myVtv"><field name="TEXT">https://www.w3schools.com/excel/vlookup7.png</field></block></value><next><block type="component_set_get" id="3GU6eUjrC}~Ug2(iKI_A"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description4"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description4</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="6W7g0,7jz!F=YExq,1s@"><field name="TEXT">اكتب FALSE لضمان البحث عن تطابق تام، ثم أغلق القوس واضغط Enter. ستظهر لك المعلومة المطلوبة فوراً.</field></block></value><next><block type="component_set_get" id="9TBd=Y6gXfJdI$7kDx6S"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image3"></mutation><field name="COMPONENT_SELECTOR">Start_Image3</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="sB=k6T3ZFE-M~v-9JJi8"><field name="TEXT">https://www.w3schools.com/excel/vlookup10.png</field></block></value><next><block type="component_set_get" id="`17X$~l)T;jTE9;myE-6"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description6"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description6</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="~dSQj=cCj-8/e$/-geM]"><field name="TEXT">جرب الدلة مثل ما ظاهر امامك</field></block></value><next><block type="component_set_get" id="k3qZFlKNxa{)}?G683c;"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="WebViewer" set_or_get="set" property_name="HomeUrl" is_generic="false" instance_name="WebViewer1"></mutation><field name="COMPONENT_SELECTOR">WebViewer1</field><field name="PROP">HomeUrl</field><value name="VALUE"><block type="text" id="`gkM.WH[D?RnANMzpY}M"><field name="TEXT">https://excel-practice-online.com/wp-content/uploads/2019/11/Vlookup.gif</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><value name="IF8"><block type="logic_compare" id="9.iB@bGOG~|iAlQW[0LC"><field name="OP">EQ</field><value name="A"><block type="controls_getStartValue" id="+(r;={a@g65ox/%UCbR%"></block></value><value name="B"><block type="text" id="zF$Fz@,,$g,%`z3PCT%;"><field name="TEXT">MAX</field></block></value></block></value><statement name="DO8"><block type="component_set_get" id=")|Zf$R6/?+`6il2|gL;_"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Title"></mutation><field name="COMPONENT_SELECTOR">Title</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="@t:_aIy6ImF]3lu{?jFl"><field name="TEXT">دالة إيجاد أكبر قيمة (MAX)</field></block></value><next><block type="component_set_get" id="6(izhhl0jT,ME|%9y/BA"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="(y52n39Co@.lf~7x_o:]"><field name="TEXT">تستخدم هذه الدالة للبحث في مجموعة من الأرقام وإعطائك أكبر رقم موجود بينهم. (مثال: من هو صاحب أعلى درجة في الفصل؟ أو ما هي أعلى قيمة مبيعات هذا الشهر؟).</field></block></value><next><block type="component_set_get" id="WpBqi$(etqeuGeiA4j|T"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image"></mutation><field name="COMPONENT_SELECTOR">Start_Image</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="R)f)qs7g02v0ClS_Vx67"><field name="TEXT">https://www.w3schools.com/excel/max1.png</field></block></value><next><block type="component_set_get" id="W[IQ;uAknH.ilW7B^HJa"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description2"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description2</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="XqS|kE}K^[LVjctjE7;l"><field name="TEXT">اضغط على الخلية التي تريد إظهار النتيجة بها واكتب علامة التساوي متبوعة باسم الدالة: =MAX(.</field></block></value><next><block type="component_set_get" id=".M]sVHRHHCHbb%(~c!3^"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description3"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description3</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="e2j,zU8U7?ytI?P48#7$"><field name="TEXT">قم بتحديد كافة الخلايا التي تحتوي على الأرقام التي تريد مقارنتها والبحث عن أكبرها.</field></block></value><next><block type="component_set_get" id="C1m`/IM%q4K[8p5?kCHD"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Syntax"></mutation><field name="COMPONENT_SELECTOR">Lbl_Syntax</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="y~xm;7o$XB!#n)A;E4?/"><field name="TEXT">=MAX(lookup_value, lookup_array)</field></block></value><next><block type="component_set_get" id="4`GwKIAS|No;wkX(eXsN"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image2"></mutation><field name="COMPONENT_SELECTOR">Start_Image2</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="EyqwtI8+,%Bwwja6x}8G"><field name="TEXT">https://www.w3schools.com/excel/img_excel_if_grass4.png</field></block></value><next><block type="component_set_get" id="2AG]cAKCzm+u1=,[]X_w"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description4"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description4</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="phwqN8Xo7GmEm?7KUY5!"><field name="TEXT">أغلق القوس واضغط Enter. سيقوم الإكسيل فوراً بالتقاط أكبر رقم في القائمة وعرضه لك.</field></block></value><next><block type="component_set_get" id="G2)S:+CCwuHO$K4Q7nZV"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image3"></mutation><field name="COMPONENT_SELECTOR">Start_Image3</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="6Xw:KOv?{dstunpUNCOK"><field name="TEXT">https://www.w3schools.com/excel/img_excel_if_grass5.png</field></block></value><next><block type="component_set_get" id="46OH^a(2/y+|SP|Jn6Q4"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description6"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description6</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="$vQrE=MexLTF+=ei#qYA"><field name="TEXT">جرب الدلة مثل ما ظاهر امامك</field></block></value><next><block type="component_set_get" id="dv6cyJ?`RlYzwCJ88I0x"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="WebViewer" set_or_get="set" property_name="HomeUrl" is_generic="false" instance_name="WebViewer1"></mutation><field name="COMPONENT_SELECTOR">WebViewer1</field><field name="PROP">HomeUrl</field><value name="VALUE"><block type="text" id=".Cq:U({E*gd]{.v0vhE,"><field name="TEXT">https://excel-practice-online.com/wp-content/uploads/2019/11/MAX.gif</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><value name="IF9"><block type="logic_compare" id="K[_~nk,X?KQb{!STxSxB"><field name="OP">EQ</field><value name="A"><block type="controls_getStartValue" id="*O^8}TDn;MGs[:aOq$as"></block></value><value name="B"><block type="text" id=".;})wncf1k]OSz=_M=B/"><field name="TEXT">CONCAT</field></block></value></block></value><statement name="DO9"><block type="component_set_get" id="u0@*ux*p/#PIF[4)EIs+"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Title"></mutation><field name="COMPONENT_SELECTOR">Title</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="5OhAjfC0U6SkV)%bk?Q^"><field name="TEXT">دالة دمج النصوص (CONCAT)</field></block></value><next><block type="component_set_get" id="p_dqxHqX`dEJ:uKO5-,4"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="%FJIv64wy}`zu1Z8}8n6"><field name="TEXT">تستخدم هذه الدالة لربط النصوص الموجودة في خلايا متعددة وجمعها في خلية واحدة. (مثال: دمج 'الاسم الأول' مع 'اسم العائلة' لتكوين 'الاسم بالكامل').</field></block></value><next><block type="component_set_get" id="LQ;0/inozkjAG5D#7LVe"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image"></mutation><field name="COMPONENT_SELECTOR">Start_Image</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="Z2*0Oav^+W+h6%)e@;n~"><field name="TEXT">https://www.w3schools.com/excel/img_excel_concat1.png</field></block></value><next><block type="component_set_get" id="@[3!cEH}pY6D0n;Ab;k1"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description2"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description2</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="JwKuyHw2aRiOG,$G@^KG"><field name="TEXT">اكتب =CONCAT( ثم حدد الخلية الأولى التي تحتوي على النص الأول، متبوعة بفاصلة.</field></block></value><next><block type="component_set_get" id="`M{+^k3-)_qJFa:DdHTQ"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description3"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description3</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="u{ACI56XKFzkV|3bKW]+"><field name="TEXT">إذا أردت ترك مسافة بين الكلمات، ضع " " (علامتي تنصيص بينهما مسافة) ثم فاصلة، وبعدها حدد الخلية الثانية.</field></block></value><next><block type="component_set_get" id="kS6.aEr:^d4W2C*NGOWQ"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Syntax"></mutation><field name="COMPONENT_SELECTOR">Lbl_Syntax</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="EFAEqg1!6T_)dNnRnp2{"><field name="TEXT">=CONCAT(cell1, delimiter, cell2)</field></block></value><next><block type="component_set_get" id="kM9D@Svm{N+THyd=]3Dd"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image2"></mutation><field name="COMPONENT_SELECTOR">Start_Image2</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id=",4my1ohjSd#a!m{uw7tK"><field name="TEXT">https://www.w3schools.com/excel/img_excel_concat2.png</field></block></value><next><block type="component_set_get" id="WZ6d%A_~Mk8J,W~AZ2kB"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description4"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description4</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="^sq21462(u4#JjVTM,0h"><field name="TEXT">أغلق القوس واضغط Enter. ستجد أن الإكسيل قام بدمج النصوص من الخلايا المختلفة في جملة واحدة متسقة.</field></block></value><next><block type="component_set_get" id=".N,~jT0,%!e.8ypUhP!H"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image3"></mutation><field name="COMPONENT_SELECTOR">Start_Image3</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="%g3M%6ZZ_)6sD^qPh,eK"><field name="TEXT">https://www.w3schools.com/excel/img_excel_concat3.png</field></block></value><next><block type="component_set_get" id="^(homX}o10Y4w@6=V_u$"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description6"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description6</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="B,s[srUzXh)`re2UenZg"><field name="TEXT">جرب الدلة مثل ما ظاهر امامك</field></block></value><next><block type="component_set_get" id=";cMEGoI)]dV@R^sF2u!F"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="WebViewer" set_or_get="set" property_name="HomeUrl" is_generic="false" instance_name="WebViewer1"></mutation><field name="COMPONENT_SELECTOR">WebViewer1</field><field name="PROP">HomeUrl</field><value name="VALUE"><block type="text" id="fw3?n5tkf(luq87}t#El"><field name="TEXT">https://www.excelcampus.com/wp-content/uploads/2014/10/CreateCONCATENATEFormulawithCtrlLeftClickinExcel.gif</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><value name="IF10"><block type="logic_compare" id=".!2KUBI]mONJl?4eGTA5"><field name="OP">EQ</field><value name="A"><block type="controls_getStartValue" id="ZL6wp/EG:[uYn!1Md)c!"></block></value><value name="B"><block type="text" id="ju?AxfBA{}o=OP+dPg;@"><field name="TEXT">TRIM</field></block></value></block></value><statement name="DO10"><block type="component_set_get" id="~lLvCfu%O{?av[xYIZ-z"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Title"></mutation><field name="COMPONENT_SELECTOR">Title</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="jYt@fmEu@hQNVC`5?;b@"><field name="TEXT">دالة تنظيف المسافات (TRIM)</field></block></value><next><block type="component_set_get" id="q1tFHkhyFnkps9WPVA_,"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="GzQ*p_TsYb-8dS$mTQN@"><field name="TEXT">تستخدم هذه الدالة لإزالة كافة المسافات الزائدة من النص، مع ترك مسافة واحدة فقط بين الكلمات. فهي تحذف المسافات التي في بداية النص أو نهايته والمسافات المكررة في المنتصف.</field></block></value><next><block type="component_set_get" id="NG!9*Qh0M5gf@}#nMxKO"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image"></mutation><field name="COMPONENT_SELECTOR">Start_Image</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="Hypw#4`9KpU?nUK#.Y9O"><field name="TEXT">https://www.w3schools.com/excel/img_excel_trim1.png</field></block></value><next><block type="component_set_get" id="aT||qPTe3%S;7h8lVP|a"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description2"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description2</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="E-m:]bs/m0HS?L5^GUf9"><field name="TEXT">اضغط على الخلية التي تريد ظهور النص النظيف بها واكتب =TRIM( ثم حدد الخلية التي تحتوي على النص الذي تريد تنظيفه.</field></block></value><next><block type="component_set_get" id="66!oL[4-x^5lEhlYwW8m"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description3"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description3</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="r*{5)j;M/b}ZKhAI(coQ"><field name="TEXT">أغلق القوس مباشرة؛ الدالة بسيطة جداً ولا تحتاج لأي معطيات أخرى.</field></block></value><next><block type="component_set_get" id="f2y@_#t~Yu{cuHWWTp]{"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Syntax"></mutation><field name="COMPONENT_SELECTOR">Lbl_Syntax</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="_Kli!y;x~ySKvU#q{Vgt"><field name="TEXT">=TRIM(start cell:end cell)</field></block></value><next><block type="component_set_get" id="9y9GLdtHHI/*i/[9s9K="><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image2"></mutation><field name="COMPONENT_SELECTOR">Start_Image2</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="aND#j?%,*.iBHgUd[,s`"><field name="TEXT">https://www.w3schools.com/excel/img_excel_trim2.png</field></block></value><next><block type="component_set_get" id="sc2:[6dM(Ak*!fw29{*j"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description4"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description4</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="okry|o,3cvm(2[i4wKpn"><field name="TEXT">اضغط Enter. ستلاحظ أن النص أصبح منسقاً تماماً وتم حذف كل الفراغات المزعجة التي كانت تعيق العمليات الحسابية أو البحث.</field></block></value><next><block type="component_set_get" id="sNX)=bi|YdpD9{5/_[9("><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image3"></mutation><field name="COMPONENT_SELECTOR">Start_Image3</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="`O;7clgw7Fvc8YfRnrOE"><field name="TEXT">https://www.w3schools.com/excel/img_excel_trim3.png</field></block></value><next><block type="component_set_get" id="$~1(0Qn_TXXyABWN(b)*"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description6"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description6</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="L7!u%L`A7IBqp]T+O_vJ"><field name="TEXT">جرب الدلة مثل ما ظاهر امامك</field></block></value><next><block type="component_set_get" id="YDT_f.zKo=DF#})L-%p."><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="WebViewer" set_or_get="set" property_name="HomeUrl" is_generic="false" instance_name="WebViewer1"></mutation><field name="COMPONENT_SELECTOR">WebViewer1</field><field name="PROP">HomeUrl</field><value name="VALUE"><block type="text" id="5~dbmxrz5Yc$P^szbSM?"><field name="TEXT">https://excel-practice-online.com/wp-content/uploads/2020/10/trim.gif</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><value name="IF11"><block type="logic_compare" id="7GiWIJw{jZkehf#N/V[#"><field name="OP">EQ</field><value name="A"><block type="controls_getStartValue" id="Unon{;6HK`QHl|Lms?B~"></block></value><value name="B"><block type="text" id="%Vt|{r|W.Zm!ZYc:w3sO"><field name="TEXT">LOWER</field></block></value></block></value><statement name="DO11"><block type="component_set_get" id="#B+R9G}Y(h8s|a0@0?%X"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Title"></mutation><field name="COMPONENT_SELECTOR">Title</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="Gak,CGZSpEUls$Zfar5="><field name="TEXT">دالة تصغير الحروف (LOWER)</field></block></value><next><block type="component_set_get" id="t(s#3eurcw3awb2GfS.q"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="E2VhMinXVR/]+3#JdBSB"><field name="TEXT">تستخدم هذه الدالة لتحويل كل الحروف الإنجليزية الموجودة في النص إلى حروف صغيرة (lowercase). وهي مفيدة جداً لتوحيد شكل البيانات أو لتجهيز عناوين البريد الإلكتروني.</field></block></value><next><block type="component_set_get" id="D!g?K5^_`2Z.R#JIj`!["><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image"></mutation><field name="COMPONENT_SELECTOR">Start_Image</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="./oEZ4^Gs%MIY+k@Bc]R"><field name="TEXT">https://www.w3schools.com/excel/img_excel_lower1.png</field></block></value><next><block type="component_set_get" id="}}Zq6KPDzd29!Pd%Y}L}"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description2"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description2</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="?]ynBS[Z~aLW{1|X.tL-"><field name="TEXT">اكتب علامة التساوي ثم اسم الدالة وافتح قوساً: =LOWER(، ثم اختر الخلية التي تحتوي على النص المكتوب بحروف كبيرة.</field></block></value><next><block type="component_set_get" id="C1w3n=YP:|(A{?XSkn3Y"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description3"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description3</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id=";B)#TcFYkEbOX1zhM0UL"><field name="TEXT">ببساطة، أغلق القوس ) ولا تحتاج لإضافة أي شيء آخر.</field></block></value><next><block type="component_set_get" id="/;h1qvcX~eyvPCdPNMtr"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Syntax"></mutation><field name="COMPONENT_SELECTOR">Lbl_Syntax</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="9m$rf#KKJ0ct^S11D/RT"><field name="TEXT">=LOWER(cell)</field></block></value><next><block type="component_set_get" id="7~j^k=oCpIb5HKWCts+w"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image2"></mutation><field name="COMPONENT_SELECTOR">Start_Image2</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="2P;t,_ya%J:KpwNAFL=,"><field name="TEXT">https://www.w3schools.com/excel/img_excel_lower2.png</field></block></value><next><block type="component_set_get" id="Nxr4tYe|^gAI,5}?tJ1!"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description4"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description4</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id="eE/r.!+{F!s4r|#3k=;F"><field name="TEXT">اضغط Enter. ستلاحظ أن جميع الحروف تحولت فوراً إلى حروف صغيرة بشكل منتظم</field></block></value><next><block type="component_set_get" id="fs{l6:UX/9dWmxShW][/"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Image" set_or_get="set" property_name="Picture" is_generic="false" instance_name="Start_Image3"></mutation><field name="COMPONENT_SELECTOR">Start_Image3</field><field name="PROP">Picture</field><value name="VALUE"><block type="text" id="]+G!Q!#B5}Vo337Qz8Dw"><field name="TEXT">https://www.w3schools.com/excel/img_excel_concat3.png</field></block></value><next><block type="component_set_get" id="(UwUK|3_K1|*Z0j25R=?"><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Lbl_Description6"></mutation><field name="COMPONENT_SELECTOR">Lbl_Description6</field><field name="PROP">Text</field><value name="VALUE"><block type="text" id=",~Enkzv,p$H;gfLyfO`{"><field name="TEXT">جرب الدلة مثل ما ظاهر امامك</field></block></value><next><block type="component_set_get" id="nSeuqtQ0JziaN`DFuO)."><mutation xmlns="http://www.w3.org/1999/xhtml" component_type="WebViewer" set_or_get="set" property_name="HomeUrl" is_generic="false" instance_name="WebViewer1"></mutation><field name="COMPONENT_SELECTOR">WebViewer1</field><field name="PROP">HomeUrl</field><value name="VALUE"><block type="text" id="6s]A6-jWMY(_i0ivk|C/"><field name="TEXT">https://excel-practice-online.com/wp-content/uploads/2020/11/lower-upper-pr